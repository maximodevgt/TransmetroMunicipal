# Transmetro Municipal: copiar como .env y completar APP_KEY (php artisan key:generate) y DB_PASSWORD.
APP_NAME=Transmetro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 (servicio MySQL80) en el puerto 3307, base transmetro.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=transmetro
DB_USERNAME=root
DB_PASSWORD=

# Sesión de 120 minutos sin actividad; también termina al cerrar el navegador (salvo "Recordarme").
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="transmetro@muniguate.gt"
MAIL_FROM_NAME="${APP_NAME}"

# Tarifa del pasaje en quetzales (config/transmetro.php).
TRANSMETRO_PASAJE=1.00

VITE_APP_NAME="${APP_NAME}"
